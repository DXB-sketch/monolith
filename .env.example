# Contact form (src/pages/api/contact.ts), sent with Resend: https://resend.com
# In production, set these as secrets on the Cloudflare Worker: Workers & Pages
# → monolith → Settings → Variables and Secrets (type: Secret). Locally, put
# them in .env for `astro dev`, or .dev.vars for `astro preview`. Never commit
# real values.

# A Resend API key with permission to send.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
CONTACT_TO_EMAIL=inquiry@monolithstudio.au

# The sender. Must be on a domain verified in Resend for production. Until a
# domain is verified, Resend's test sender (onboarding@resend.dev) only
# delivers to the Resend account owner's own address.
CONTACT_FROM_EMAIL=Monolith Web Studio <website@monolithstudio.au>
