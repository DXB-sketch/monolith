---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SceneStage from '../components/SceneStage.astro';
import Intro from '../components/Intro.astro';
import Cursor from '../components/Cursor.astro';
import { SITE } from '../lib/site';
import { PALETTE_HEX } from '../scene/palette';
import type { PageView } from '../scene/views';

interface Props {
  title?: string;
  description?: string;
  /** Extra class on <main>, for page-level layout. */
  mainClass?: string;
  /** The footer's "Start a project" lead; off where the page ends on its own CTA or is the form. */
  footerCta?: boolean;
  /** This page's view of the stone (content pages); the home page follows its story instead. */
  view?: PageView;
}

const { title, description = SITE.description, mainClass, footerCta = true, view } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · Wamuran, Queensland`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={PALETTE_HEX.basalt} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/posters/hero-1920.webp', Astro.site)} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href="/fonts/sora-latin-200-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/sora-latin-300-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Mark JS as available before first paint so no-JS fallbacks never flash.
         The intro shows once per session, on a direct visit to the home page:
         never a deep link, back/forward, reduced motion or a ClientRouter navigation. -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          if (location.pathname !== '/' || location.hash) return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const nav = performance.getEntriesByType('navigation')[0];
          if (nav && nav.type === 'back_forward') return;
          if (sessionStorage.getItem('monolith:intro')) return;
          sessionStorage.setItem('monolith:intro', '1');
          root.classList.add('intro-on');
          root.dataset.introAt = String(Math.round(performance.now()));
        } catch {
          // No storage: no intro.
        }
      })();
    </script>
    <!-- Browsers without View Transitions get a plain cross-fade (styles/transitions.css). -->
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <Intro />

    <a class="skip-link" href="#main">
      Skip to content
    </a>

    <SceneStage />

    <Nav />

    <main id="main" tabindex="-1" class:list={['main', mainClass]} data-scene-view={view}>
      <slot />
    </main>

    <Footer cta={footerCta} />

    <Cursor />

    <script>
      import { initSceneBoot } from '../lib/scene-boot';
      import { initMorphs } from '../lib/morph';
      import { initPageFocus } from '../lib/page-focus';
      initSceneBoot();
      initMorphs();
      initPageFocus();

      // The custom cursor: desktops with a fine pointer and motion allowed only.
      // Touch screens and reduced motion never download it.
      if (
        matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        import('../lib/cursor').then((m) => m.mountCursor());
      }

      // Dev overlay for real-device testing. Only fetched when ?fps is in the URL.
      if (new URLSearchParams(location.search).has('fps')) {
        import('../lib/fps-overlay').then((m) => m.mountFpsOverlay());
      }
    </script>
  </body>
</html>

<style>
  .main {
    position: relative;
    z-index: var(--z-content);
    display: block;
  }

  .main:focus {
    outline: none;
  }
</style>
