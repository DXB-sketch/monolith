---
/**
 * Dev-only scene viewer, used by scripts/render-posters.mjs and the cost and
 * capture scripts. It lives outside src/pages: the `dev-routes` integration
 * (astro.config.mjs) injects it as /dev/scene under `astro dev` only, so
 * production builds contain neither the page nor its script.
 *
 *   /dev/scene?tier=high|medium|lite   live scene, no UI (every layer, fixed tier)
 *   /dev/scene?capture=12         frozen at t = 12s, drawing buffer preserved
 *   &progress=0.36                story progress (default story map), with capture
 *   &view=work                    a page view (Phase 4) instead of the story
 *   &hide=lava,embers&nopost      isolate objects, skip post-processing
 *   &nohaze                       no heat haze (High), to measure its cost
 *   &scale=0.5                    hold a resolution scale (default 1)
 *   &orbit                        with capture: the capture-only orbit path (Phase 6,
 *                                 scripts/render-orbit.ts); window.__orbitFrame(time, degrees)
 *                                 renders one frame of it
 * window.__gpu() returns per-layer GPU milliseconds (EXT_disjoint_timer_query_webgl2).
 */
import '../styles/global.css';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Scene viewer</title>
  </head>
  <body>
    <canvas data-dev-canvas></canvas>
    <div class="wash" data-dev-wash></div>
    <script>
      import { createScene } from '../scene/index';
      import { isPageView } from '../scene/views';

      const params = new URLSearchParams(location.search);
      const requested = params.get('tier');
      const tier = requested === 'medium' || requested === 'lite' ? requested : 'high';
      const captureAt = params.get('capture');
      const pointer = params.get('pointer')?.split(',').map(Number);
      const view = params.get('view');
      const pageView = isPageView(view) ? view : undefined;
      const canvas = document.querySelector<HTMLCanvasElement>('[data-dev-canvas]')!;
      const w = window as unknown as { __sceneReady?: boolean; __sceneError?: string };

      createScene(canvas, {
        tier,
        gpuTiming: true,
        fixedTier: true,
        fixedScale: Number(params.get('scale') ?? 1),
        onIssue: (message) => console.warn('[scene]', message),
        // Without a post chain (Lite), the Chapter 04 wash is a CSS layer, as on the site.
        onWash: (amount, css) => {
          const wash = document.querySelector<HTMLElement>('[data-dev-wash]')!;
          wash.style.backgroundColor = css;
          wash.style.opacity = String(amount);
        },
        onPhase: (name, detail) => console.info('[scene]', name, detail ?? ''),
        debugHide: params.get('hide')?.split(','),
        debugNoPost: params.has('nopost'),
        debugNoHaze: params.has('nohaze'),
        capture: captureAt
          ? {
              time: Number(captureAt),
              progress: Number(params.get('progress') ?? 0),
              view: pageView,
              orbit: params.has('orbit') ? 0 : undefined,
            }
          : undefined,
        onFirstFrame: () => {
          // Give the frozen frame a few extra renders so pointer heat settles.
          setTimeout(() => (w.__sceneReady = true), captureAt ? 1500 : 0);
        },
      })
        .then((scene) => {
          (window as unknown as { __gpu?: unknown }).__gpu = () => scene.gpuTimings();
          // The orbit sequence: one frame per call, drawn on the next animation frame.
          (window as unknown as { __orbitFrame?: unknown }).__orbitFrame = (
            time: number,
            degrees: number,
          ) =>
            new Promise<void>((done) => {
              scene.captureFrame(time, degrees);
              requestAnimationFrame(() => requestAnimationFrame(() => done()));
            });
          // Orbit capture draws only on request: no loop, so no first-frame callback either.
          if (params.has('orbit') && captureAt) {
            w.__sceneReady = true;
            return;
          }
          if (pointer && pointer.length === 2) scene.setPointer(pointer[0]!, pointer[1]!);
          if (pageView && !captureAt) scene.setView(pageView, { immediate: true });
          scene.resume();
        })
        .catch((error: unknown) => {
          w.__sceneError = String(error);
          console.error(error);
        });
    </script>
    <style>
      html,
      body {
        height: 100%;
        overflow: hidden;
      }

      canvas,
      .wash {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .wash {
        opacity: 0;
        pointer-events: none;
      }
    </style>
  </body>
</html>
