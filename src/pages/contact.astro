---
/**
 * Start a project: the brief form, a call booking, and email.
 *
 * Rendered on demand (not prerendered): the form carries a freshly signed
 * start time for the spam check, and a plain-form submission that fails
 * validation comes back here with its errors and answers.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactForm from '../components/ContactForm.astro';
import BookCall from '../components/BookCall.astro';
import { readFlash } from '../lib/contact-flash';
import { issueToken } from '../lib/contact-server';
import { SITE } from '../lib/site';

export const prerender = false;

const flash = readFlash(Astro.cookies);
const formError = flash?.sendFailed
  ? 'send'
  : Astro.url.searchParams.get('error') === 'invalid'
    ? 'invalid'
    : null;
// The page varies per request (token, errors): never cached.
Astro.response.headers.set('cache-control', 'no-store');
---

<BaseLayout
  footerCta={false}
  title="Start a project"
  description="Tell Monolith Web Studio about your website project: a short brief (what you need, budget, timeline) or book a call. Based in Wamuran, Queensland."
>
  <PageIntro
    eyebrow="Contact"
    title="Let’s make something"
    accent="that stands."
    lead="Tell me what you need and roughly what you’d like to spend. I’ll come back with honest advice."
  />

  <section class="contact" aria-label="Project brief">
    <div class="container contact__grid">
      <ContactForm
        token={issueToken()}
        values={flash?.values}
        errors={flash?.errors}
        formError={formError}
      />
      <aside class="contact__aside" aria-label="Other ways to get in touch">
        <BookCall />
        <div class="contact__email">
          <h2 class="subheading">Or email me</h2>
          <p>{SITE.email}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    position: relative;
    padding-bottom: var(--space-3xl);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 44rem) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 64rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .contact__aside {
    display: grid;
    gap: var(--space-l);
  }

  .contact__email {
    display: grid;
    gap: var(--space-xs);
    padding-inline: var(--space-l);
  }
</style>
