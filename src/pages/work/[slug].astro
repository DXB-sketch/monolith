---
/**
 * A case study, in the order of docs/BRIEF.md: hero, summary, the challenge,
 * key decisions, visuals, results (only if real), a quote (only if real), the
 * next project, then Start a project. A section without data is left out
 * entirely; nothing renders empty.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NextStep from '../../components/NextStep.astro';
import Recording from '../../components/Recording.astro';
import { CONCEPT_NOTE, getWork, hostOf, type WorkEntry } from '../../lib/work';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry, index) => ({
    params: { slug: entry.id },
    // The last project loops back to the first.
    props: { entry, next: work[(index + 1) % work.length]! },
  }));
}

interface Props {
  entry: WorkEntry;
  next: WorkEntry;
}

const { entry, next } = Astro.props;
const data = entry.data;
const AREAS = {
  design: 'Design',
  technical: 'Technical',
  accessibility: 'Accessibility',
} as const;
const decisionsByArea = (Object.keys(AREAS) as (keyof typeof AREAS)[])
  .map((area) => ({ area, items: data.decisions.filter((d) => d.area === area) }))
  .filter((group) => group.items.length);
const lighthouse = data.results?.lighthouse;
const resultNotes = data.results?.notes ?? [];
const hasResults = Boolean(lighthouse) || resultNotes.length > 0;
const SCORES = [
  ['performance', 'Performance'],
  ['accessibility', 'Accessibility'],
  ['bestPractices', 'Best practices'],
  ['seo', 'SEO'],
] as const;
---

<BaseLayout
  title={data.seo?.title ?? data.title}
  description={data.seo?.description ?? data.summary}
>
  <header class="case-hero">
    <div class="container case-hero__inner">
      <p class="label case-hero__eyebrow">
        <a href="/work">Work</a>
        <span aria-hidden="true"> / </span>
        <span>{data.isConcept ? 'Concept' : 'Case study'}</span>
      </p>
      <h1 class="display case-hero__title">{data.title}</h1>
      <dl class="case-hero__facts">
        <div>
          <dt class="label">Client</dt>
          <dd>{data.client}</dd>
        </div>
        <div>
          <dt class="label">Type</dt>
          <dd>{data.clientType}</dd>
        </div>
        <div>
          <dt class="label">Year</dt>
          <dd>{data.year}</dd>
        </div>
      </dl>
      {data.isConcept && (
        <p class="case-hero__concept">
          <span class="case-hero__badge label">Concept</span>
          <span>{CONCEPT_NOTE}</span>
        </p>
      )}
      <p class="lead case-hero__summary">{data.summary}</p>
      {data.liveUrl && (
        <a class="btn btn--ghost" href={data.liveUrl} rel="noopener">
          Visit the live site: {hostOf(data.liveUrl)}
          <span class="btn__arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      )}
    </div>
  </header>

  <section class="case-section" aria-labelledby="challenge-title">
    <div class="container case-section__inner" data-reveal>
      <h2 id="challenge-title" class="label case-section__label">
        The challenge
      </h2>
      <p class="case-section__text">{data.challenge}</p>
    </div>
  </section>

  <section class="case-section" aria-labelledby="decisions-title">
    <div class="container case-section__inner">
      <h2 id="decisions-title" class="label case-section__label" data-reveal>
        Key decisions
      </h2>
      <div class="decisions">
        {decisionsByArea.map((group) => (
          <div class="decisions__group" data-reveal>
            <h3 class="subheading">{AREAS[group.area]}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item.text}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="case-visuals" aria-labelledby="visuals-title">
    <div class="container">
      <h2 id="visuals-title" class="label case-section__label">
        Visuals
      </h2>
      <div class="case-visuals__grid">
        <figure class="case-visuals__item case-visuals__item--wide" data-reveal>
          <Picture
            src={data.cover}
            alt={data.coverAlt}
            formats={['avif', 'webp']}
            widths={[640, 1280, 1920]}
            sizes="(min-width: 90rem) 84rem, 94vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
        {data.gallery?.map((item) =>
          item.type === 'video' ? (
            <div class="case-visuals__item case-visuals__item--wide" data-reveal>
              <Recording src={item.src} poster={item.poster} description={item.description} />
            </div>
          ) : (
            <figure
              class:list={[
                'case-visuals__item',
                item.wide ? 'case-visuals__item--wide' : 'case-visuals__item--narrow',
              ]}
              data-reveal
            >
              <Picture
                src={item.src}
                alt={item.alt}
                formats={['avif', 'webp']}
                widths={item.wide ? [640, 1280, 1920] : [400, 800]}
                sizes={
                  item.wide ? '(min-width: 90rem) 84rem, 94vw' : '(min-width: 48rem) 40vw, 94vw'
                }
                loading="lazy"
                decoding="async"
              />
            </figure>
          ),
        )}
      </div>
    </div>
  </section>

  {hasResults && (
    <section class="case-section" aria-labelledby="results-title">
      <div class="container case-section__inner" data-reveal>
        <h2 id="results-title" class="label case-section__label">
          Results
        </h2>
        {lighthouse && (
          <dl class="scores" aria-label="Lighthouse scores">
            {SCORES.map(([key, label]) => (
              <div class="scores__item">
                <dt class="label">{label}</dt>
                <dd class="scores__value">{lighthouse[key]}</dd>
              </div>
            ))}
          </dl>
        )}
        {resultNotes.length > 0 && (
          <ul class="case-section__list">
            {resultNotes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  {data.quote && (
    <section class="case-section" aria-label="Client quote">
      <figure class="container case-quote" data-reveal>
        <blockquote class="case-quote__text">
          <p>{data.quote.text}</p>
        </blockquote>
        <figcaption class="label">
          {data.quote.name}, {data.quote.role}
        </figcaption>
      </figure>
    </section>
  )}

  <nav class="next-project" aria-label="Next project">
    <div class="container">
      <a class="next-project__link" href={`/work/${next.id}`}>
        <span class="label">Next project</span>
        <span class="next-project__title">
          {next.data.title}
          <span class="next-project__arrow" aria-hidden="true">
            →
          </span>
        </span>
        <span class="label">
          {next.data.clientType}
          {next.data.isConcept && ' · Concept'}
        </span>
      </a>
    </div>
  </nav>

  <NextStep title="Want one" accent="built like this?" />
</BaseLayout>

<style>
  .case-hero {
    position: relative;
    padding-block: calc(var(--nav-height) + var(--space-3xl)) var(--space-2xl);
  }

  .case-hero__inner {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .case-hero__eyebrow a {
    color: var(--ash);
  }

  .case-hero__title {
    max-width: 14ch;
    overflow-wrap: anywhere;
  }

  .case-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-xl);
    margin: 0;
  }

  .case-hero__facts div {
    display: grid;
    gap: var(--space-3xs);
  }

  .case-hero__facts dd {
    margin: 0;
    color: var(--bone);
  }

  .case-hero__concept {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: center;
    color: var(--ash-soft);
  }

  .case-hero__badge {
    padding: 0.2em 0.8em;
    border: 1px solid var(--lava);
    border-radius: var(--radius-pill);
    color: var(--bone);
  }

  .case-hero__summary {
    max-width: 44ch;
  }

  .case-section {
    position: relative;
    padding-block: var(--space-xl);
  }

  .case-section__inner {
    display: grid;
    gap: var(--space-m);
  }

  .case-section__label {
    color: var(--lava);
  }

  .case-section__text {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--ash-soft);
  }

  .case-section__list {
    display: grid;
    gap: var(--space-2xs);
    max-width: var(--measure);
    padding-left: 1.2em;
  }

  .decisions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-s);
  }

  .decisions__group {
    display: grid;
    align-content: start;
    gap: var(--space-s);
    padding: var(--space-l);
    border: var(--hairline);
    border-top: var(--rule-accent);
    border-radius: var(--radius-panel);
    background: var(--panel-bg);
  }

  .decisions__group ul {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding-left: 1.2em;
  }

  .decisions__group li::marker {
    color: var(--lava);
  }

  .case-visuals {
    position: relative;
    padding-block: var(--space-xl);
  }

  .case-visuals__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .case-visuals__item {
    margin: 0;
  }

  .case-visuals__item--wide {
    grid-column: 1 / -1;
  }

  @media (max-width: 48rem) {
    .case-visuals__item--narrow {
      grid-column: 1 / -1;
    }
  }

  .case-visuals__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--hairline);
    border-radius: var(--radius-panel);
  }

  .scores {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    margin: 0;
  }

  .scores__item {
    display: grid;
    gap: var(--space-3xs);
  }

  .scores__value {
    margin: 0;
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    color: var(--bone);
  }

  .case-quote {
    display: grid;
    gap: var(--space-m);
    margin-block: 0;
  }

  .case-quote__text {
    margin: 0;
    max-width: 30ch;
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    line-height: 1.2;
    color: var(--bone);
  }

  .next-project {
    position: relative;
    padding-block: var(--space-2xl) var(--space-m);
  }

  .next-project__link {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-xl);
    border-top: var(--hairline);
    border-bottom: var(--hairline);
    color: var(--color-text);
    text-decoration: none;
  }

  .next-project__title {
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    overflow-wrap: anywhere;
    transition: color var(--dur-base) var(--ease-out);
  }

  .next-project__arrow {
    display: inline-block;
    color: var(--lava);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .next-project__link:hover .next-project__title,
  .next-project__link:focus-visible .next-project__title {
    color: var(--lava-hot);
  }

  .next-project__link:hover .next-project__arrow {
    transform: translateX(0.15em);
  }
</style>
