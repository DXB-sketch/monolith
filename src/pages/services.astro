---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ServiceCard from '../components/ServiceCard.astro';
import NextStep from '../components/NextStep.astro';
import { SERVICES, PROCESS, FAQ, CARE } from '../lib/site';
---

<BaseLayout
  og="services"
  view="services"
  footerCta={false}
  title="Services and pricing"
  description="Three website packages from Monolith Web Studio (Ember, Flow and Eruption) with starting prices, what’s included, the process and answers to common questions."
>
  <PageIntro
    eyebrow="Services"
    title="Three ways to"
    accent="work together."
    lead="Every package is designed and hand-built by me, fast and accessible from day one."
  />

  <section class="services" aria-labelledby="packages-title">
    <div class="container">
      <h2 id="packages-title" class="visually-hidden">
        Packages
      </h2>
      <ul class="services__grid">
        {SERVICES.map((service, index) => (
          <li data-reveal>
            <ServiceCard service={service} index={index} detailed level={3} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block" aria-labelledby="care-title">
    <div class="container block__inner" data-reveal>
      <h2 id="care-title" class="heading">
        Ongoing care and hosting
      </h2>
      {CARE.details.map((text) => (
        <p class="block__text">{text}</p>
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="process-title">
    <div class="container block__inner">
      <h2 id="process-title" class="heading" data-reveal>
        How it works
      </h2>
      <ol class="process">
        {PROCESS.map((step, index) => (
          <li class="process__step" data-reveal data-sheen>
            <span class="label process__num">0{index + 1}</span>
            <h3 class="subheading">{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block" aria-labelledby="faq-title">
    <div class="container block__inner">
      <h2 id="faq-title" class="heading" data-reveal>
        Questions
      </h2>
      <div class="faq" data-reveal>
        {FAQ.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">{item.q}</summary>
            <p class="faq__answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <NextStep
    title="Not sure which"
    accent="fits?"
    text="Tell me about the project and your budget. I’ll recommend the package that makes sense, or tell you honestly if none of them do."
  />
</BaseLayout>

<style>
  .services {
    position: relative;
    padding-bottom: var(--space-xl);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .services__grid > li {
    display: grid;
  }

  .block {
    position: relative;
    padding-block: var(--space-xl);
  }

  .block__inner {
    display: grid;
    gap: var(--space-l);
  }

  .block__text {
    max-width: var(--measure);
    color: var(--ash-soft);
  }

  .process {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process__step {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-l);
    border: var(--hairline);
    border-top: var(--rule-accent);
    border-radius: var(--radius-panel);
    background: var(--panel-bg);
  }

  .process__num {
    color: var(--lava);
  }

  .faq {
    display: grid;
    max-width: 48rem;
    border-top: var(--hairline);
  }

  .faq__item {
    border-bottom: var(--hairline);
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    align-items: center;
    min-height: 44px;
    padding-block: var(--space-m);
    font-size: var(--step-1);
    color: var(--bone);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: '+';
    flex: none;
    font-family: var(--font-mono);
    color: var(--lava);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .faq__item[open] .faq__question::after {
    transform: rotate(45deg);
  }

  .faq__answer {
    max-width: var(--measure);
    padding-bottom: var(--space-m);
    color: var(--ash-soft);
  }
</style>
