---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA } from '../lib/site';
import { studio } from '../lib/structured-data';
---

<BaseLayout jsonLd={studio(Astro.site!)} stage={false}>
  <section class="container" style="padding-block: 8rem">
    <h1 class="display">Your business deserves better than a template.</h1>
    <p><a href={CTA.href}>{CTA.label}</a> · <a href="/potential">See the potential</a></p>
  </section>
</BaseLayout>
