---
/**
 * The home page (Phase 6): a 2D landing page whose first job is to sell the
 * studio. Static HTML plus two light scripts loaded after first paint
 * (src/lib/landing.ts for motion, src/lib/orbit.ts for the hero's stone);
 * nothing in its graph imports Three.js. The stone in the hero is the real
 * scene, pre-rendered (npm run orbit). The 3D story is at /potential.
 *
 * Layout: "strata". Sections alternate two basalt tones; each after the hero
 * overlaps the one above by 40px with its own jagged top edge (a clip-path,
 * traced by a thin ember line), and a lava thread runs down the left gutter
 * with a node per section (docs/ART_DIRECTION.md, "2D landing").
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCard from '../components/PackageCard.astro';
import { CARE, CTA, PROCESS, SERVICES, SITE } from '../lib/site';
import { getWork, toProject } from '../lib/work';
import { studio } from '../lib/structured-data';
import orbit from '../../public/media/orbit/orbit.json';

const entries = await getWork();
const entry = (slug: string) => entries.find((e) => e.id === slug);
const seqdvgc = entry('seqdvgc')!;
const allen = entry('allen-gillon')!;
// Shown once the owner adds its screenshots and removes `draft` (published entries only).
const tigers = entry('tigers-training-hub');

/** A project's tags, from facts in its entry: its type, year and what the work focused on. */
const tagsOf = (slug: string) => {
  const e = entry(slug)!;
  const project = toProject(e);
  const areas = [...new Set(e.data.decisions.map((d) => d.area))].map(
    (area) => area[0]!.toUpperCase() + area.slice(1),
  );
  return [project.clientType, project.year, ...areas].filter(Boolean) as string[];
};

// The founder photo, once it's added as src/assets/founder.jpg (never a placeholder box).
const founderImages = import.meta.glob<{ default: ImageMetadata }>('../assets/founder.jpg', {
  eager: true,
});
const founder = Object.values(founderImages)[0]?.default;

const launch = SERVICES[0]!;
const fromPrice = launch.price[0]!.toUpperCase() + launch.price.slice(1);
const ACTIONS = ['Start with Ember', 'Start with Flow', 'Talk about Eruption'];

/**
 * Each stratum's top edge: points as [x %, y px] across the 40px overlap. The
 * same points draw the clip-path and the ember line, so they always match.
 */
const EDGES: Record<string, [number, number][]> = {
  work: [
    [0, 30],
    [6, 19],
    [12, 26],
    [21, 9],
    [30, 21],
    [39, 13],
    [51, 29],
    [60, 17],
    [69, 25],
    [78, 7],
    [87, 22],
    [94, 14],
    [100, 24],
  ],
  about: [
    [0, 13],
    [8, 27],
    [17, 11],
    [27, 23],
    [35, 6],
    [46, 25],
    [56, 15],
    [65, 31],
    [74, 12],
    [83, 26],
    [92, 9],
    [100, 21],
  ],
  process: [
    [0, 24],
    [10, 8],
    [18, 22],
    [29, 15],
    [37, 30],
    [48, 10],
    [58, 24],
    [67, 6],
    [77, 20],
    [86, 12],
    [93, 28],
    [100, 15],
  ],
  packages: [
    [0, 9],
    [7, 22],
    [16, 14],
    [24, 31],
    [34, 18],
    [43, 6],
    [53, 21],
    [62, 13],
    [72, 29],
    [81, 10],
    [90, 24],
    [100, 12],
  ],
  core: [
    [0, 27],
    [9, 14],
    [19, 25],
    [28, 7],
    [38, 18],
    [49, 30],
    [59, 11],
    [68, 23],
    [77, 16],
    [86, 31],
    [94, 12],
    [100, 26],
  ],
};
const clipOf = (points: [number, number][]) =>
  `polygon(${points.map(([x, y]) => `${x}% ${y}px`).join(', ')}, 100% 100%, 0% 100%)`;
const lineOf = (points: [number, number][]) => points.map(([x, y]) => `${x},${y}`).join(' ');
const edge = (name: string) => ({ clip: clipOf(EDGES[name]!), line: lineOf(EDGES[name]!) });

const orbitManifest = JSON.stringify({
  base: '/media/orbit/',
  desktop: { frames: orbit.desktop.frames, step: orbit.desktop.stepDegrees },
  phone: { frames: orbit.phone.frames, step: orbit.phone.stepDegrees },
});
---

<BaseLayout
  jsonLd={studio(Astro.site!)}
  stage={false}
  footerCta={false}
  description="Custom websites for South East Queensland businesses: fast, accessible and designed for you, from $699. One person, Dexter, from the first chat to well after launch."
>
  <div class="landing" data-landing>
    <div class="thread" aria-hidden="true">
      <span class="thread__fill" data-thread-fill></span>
    </div>

    <!-- 0 — Hero -->
    <section id="top" class="stratum stratum--hero" aria-labelledby="hero-title" data-stratum>
      <span class="node" aria-hidden="true" data-node></span>
      <div class="frame hero">
        <div class="hero__copy">
          <p class="eyebrow">CUSTOM WEBSITES · SOUTH EAST QUEENSLAND</p>
          <h1 id="hero-title" class="hero__title" tabindex="-1">
            Your business deserves better than <em>a template.</em>
          </h1>
          <p class="hero__lead">
            I design and build fast, accessible, custom websites for cafés, clubs, tradies, makers
            and local brands. You deal with me, the person doing the work, from the first chat to
            well after launch.
          </p>
          <div class="actions">
            <a class="btn btn--primary" href={CTA.href} data-magnetic>
              {CTA.label}
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            </a>
            <a class="btn btn--ghost" href="#work">
              See the work
              <span class="btn__arrow" aria-hidden="true">
                ↓
              </span>
            </a>
          </div>
          <ul class="facts">
            <li class="fact">
              <span class="fact__value">{fromPrice}</span>
              <span class="fact__label">LAUNCH SITES</span>
            </li>
            <li class="fact">
              <span class="fact__value">Under 2 weeks</span>
              <span class="fact__label">FOR SIMPLER SITES</span>
            </li>
            <li class="fact">
              <span class="fact__value">2 months</span>
              <span class="fact__label">OF FREE FIXES</span>
            </li>
          </ul>
        </div>

        <!-- The stone: frames rendered from the real scene, turned by scroll (src/lib/orbit.ts). -->
        <div class="orbit" data-orbit data-manifest={orbitManifest}>
          <picture>
            <source
              type="image/avif"
              media="(min-width: 900px)"
              srcset={`/media/orbit/${orbit.desktop.poster}`}
            />
            <source
              type="image/webp"
              media="(min-width: 900px)"
              srcset={`/media/orbit/${orbit.desktop.frames[0]}`}
            />
            <source type="image/avif" srcset={`/media/orbit/${orbit.phone.poster}`} />
            <img
              class="orbit__still"
              src={`/media/orbit/${orbit.phone.frames[0]}`}
              alt=""
              width={orbit.desktop.width}
              height={orbit.desktop.height}
              decoding="async"
            />
          </picture>
          <canvas class="orbit__canvas" aria-hidden="true" data-orbit-canvas></canvas>
          <span class="orbit__tick orbit__tick--tl" aria-hidden="true"></span>
          <span class="orbit__tick orbit__tick--tr" aria-hidden="true"></span>
          <span class="orbit__tick orbit__tick--bl" aria-hidden="true"></span>
          <span class="orbit__tick orbit__tick--br" aria-hidden="true"></span>
          <p class="orbit__caption">
            <span class="orbit__hint">SCROLL TO TURN THE STONE</span>
            <span class="orbit__angle" aria-hidden="true" data-orbit-angle>
              000°
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- 1 — Work -->
    <section id="work" class="stratum stratum--alt" aria-labelledby="work-title" data-stratum>
      <div class="stratum__bg" style={`clip-path: ${edge('work').clip}`}></div>
      <svg
        class="stratum__edge"
        viewBox="0 0 100 40"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <polyline points={edge('work').line} vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <span class="node" aria-hidden="true" data-node></span>
      <div class="frame">
        <header class="section-head section-head--split">
          <div class="section-head__text">
            <p class="eyebrow">
              <span class="eyebrow__num">01</span> — WORK
            </p>
            <h2 id="work-title" class="section-title" data-reveal="lines">
              Real projects for real local clients.
            </h2>
          </div>
          <a class="text-link" href="/work">
            All case studies <span aria-hidden="true">→</span>
          </a>
        </header>

        <article class="panel panel--lead" aria-labelledby="work-seqdvgc" data-tilt data-reveal>
          <div class="panel__media">
            <Picture
              src={seqdvgc.data.cover}
              alt={seqdvgc.data.coverAlt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(min-width: 900px) 58vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="panel__body">
            <p class="panel__label">CLUB WEBSITE · EVENTS + BOOKINGS</p>
            <h3 id="work-seqdvgc" class="panel__title">
              {seqdvgc.data.title}
            </h3>
            <p class="panel__text">{seqdvgc.data.summary}</p>
            <ul class="tags" aria-label="Project details">
              {tagsOf('seqdvgc').map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <a class="text-link" href="/work/seqdvgc">
              Read the case study<span class="visually-hidden">: {seqdvgc.data.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <span class="panel__glow" aria-hidden="true"></span>
        </article>

        <div class:list={['panel-pair', { 'panel-pair--single': !tigers }]}>
          <article class="panel panel--wide" aria-labelledby="work-allen" data-tilt data-reveal>
            <div class="panel__media">
              <Picture
                src={allen.data.cover}
                alt={allen.data.coverAlt}
                formats={['avif', 'webp']}
                widths={[480, 800]}
                sizes={tigers ? '(min-width: 900px) 30vw, 100vw' : '(min-width: 900px) 40vw, 100vw'}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="panel__body">
              <p class="panel__label">MUSICIAN · BRIBIE ISLAND</p>
              <h3 id="work-allen" class="panel__title">
                {allen.data.title}
              </h3>
              <p class="panel__text">{allen.data.summary}</p>
              <ul class="tags" aria-label="Project details">
                {tagsOf('allen-gillon').map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <a class="text-link" href="/work/allen-gillon">
                Read the case study<span class="visually-hidden">: {allen.data.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
            <span class="panel__glow" aria-hidden="true"></span>
          </article>

          {tigers && (
            <article class="panel" aria-labelledby="work-tigers" data-tilt data-reveal>
              <div class="panel__body">
                <p class="panel__label">WEB APP · FOOTBALL CLUB</p>
                <h3 id="work-tigers" class="panel__title">
                  {tigers.data.title}
                </h3>
                <p class="panel__text">
                  Real software, not a brochure: a training hub web app built for the club’s coaches
                  and players.
                </p>
                <a class="text-link" href={`/work/${tigers.id}`}>
                  See the walkthrough<span class="visually-hidden">: {tigers.data.title}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
              <span class="panel__glow" aria-hidden="true" />
            </article>
          )}
        </div>
      </div>
    </section>

    <!-- 2 — Why me -->
    <section id="about" class="stratum" aria-labelledby="about-title" data-stratum>
      <div class="stratum__bg" style={`clip-path: ${edge('about').clip}`}></div>
      <svg
        class="stratum__edge"
        viewBox="0 0 100 40"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <polyline points={edge('about').line} vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <span class="node" aria-hidden="true" data-node></span>
      <div class:list={['frame', 'why', { 'why--photo': founder }]}>
        {founder && (
          <div class="why__photo" data-reveal>
            <Picture
              src={founder}
              alt={`${SITE.founder}, the person behind Monolith`}
              formats={['avif', 'webp']}
              widths={[400, 700]}
              sizes="(min-width: 900px) 30vw, 100vw"
              loading="lazy"
            />
          </div>
        )}
        <div class="why__copy">
          <p class="eyebrow">
            <span class="eyebrow__num">02</span> — WHY ME
          </p>
          <h2 id="about-title" class="section-title" data-reveal="lines">
            One person. <strong>Start to finish.</strong>
          </h2>
          <p class="why__body" data-reveal>
            I’m Dexter, a Bribie Island local who’s been building websites for about four years.
            Monolith is just me, on purpose. No account managers, no hand-offs, no wondering who’s
            actually working on your site.
          </p>
          <a class="text-link" href="/about" data-reveal>
            More about me <span aria-hidden="true">→</span>
          </a>
        </div>
        <dl class="reasons" data-reveal>
          <div class="reason">
            <dt>You talk to the builder</dt>
            <dd>Every question goes straight to the person who can answer it.</dd>
          </div>
          <div class="reason">
            <dt>Fast and accessible</dt>
            <dd>Built to load quickly on any phone and work for every visitor.</dd>
          </div>
          <div class="reason">
            <dt>It’s yours</dt>
            <dd>
              After launch everything moves into your ownership, and you can update it yourself.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- 3 — How it works -->
    <section id="process" class="stratum stratum--alt" aria-labelledby="process-title" data-stratum>
      <div class="stratum__bg" style={`clip-path: ${edge('process').clip}`}></div>
      <svg
        class="stratum__edge"
        viewBox="0 0 100 40"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <polyline points={edge('process').line} vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <span class="node" aria-hidden="true" data-node></span>
      <div class="frame">
        <header class="section-head">
          <p class="eyebrow">
            <span class="eyebrow__num">03</span> — HOW IT WORKS
          </p>
          <h2 id="process-title" class="section-title" data-reveal="lines">
            Four steps. No surprises.
          </h2>
        </header>
        <ol class="steps" data-reveal>
          {PROCESS.map((step, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="step__name">{step.name}</h3>
              <p class="step__text">{step.text}</p>
            </li>
          ))}
        </ol>
        <p class="mono-line" data-reveal>
          50% to start, 50% after launch. Bank transfer, PayID or card. Payment plans available.
        </p>
      </div>
    </section>

    <!-- 4 — Packages -->
    <section id="packages" class="stratum" aria-labelledby="packages-title" data-stratum>
      <div class="stratum__bg" style={`clip-path: ${edge('packages').clip}`}></div>
      <svg
        class="stratum__edge"
        viewBox="0 0 100 40"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <polyline points={edge('packages').line} vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <span class="node" aria-hidden="true" data-node></span>
      <div class="frame">
        <header class="section-head">
          <p class="eyebrow">
            <span class="eyebrow__num">04</span> — PACKAGES
          </p>
          <h2 id="packages-title" class="section-title" data-reveal="lines">
            Pick a starting point.
          </h2>
        </header>
        <ul class="packages">
          {SERVICES.map((service, i) => (
            <li data-reveal>
              <PackageCard
                service={service}
                index={i}
                action={ACTIONS[i]!}
                highlight={service.name === 'Eruption'}
              >
                {service.name === 'Eruption' && (
                  <p class="potential-note">
                    Want to see how far it can go? <a href="/potential">See the potential</a>, a
                    high-performance 3D demo that needs a powerful device. Client builds are made
                    lighter.
                  </p>
                )}
              </PackageCard>
            </li>
          ))}
        </ul>
        <p class="mono-line" data-reveal>
          Prefer not to deal with hosting? I can manage hosting and your domain for {CARE.price}.
        </p>
      </div>
    </section>

    <!-- 5 — The Core -->
    <section
      id="the-core"
      class="stratum stratum--alt stratum--core"
      aria-labelledby="core-title"
      data-stratum
    >
      <div class="stratum__bg" style={`clip-path: ${edge('core').clip}`}>
        <span class="core__glow" aria-hidden="true" data-core-glow></span>
      </div>
      <svg
        class="stratum__edge"
        viewBox="0 0 100 40"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <polyline points={edge('core').line} vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <span class="node" aria-hidden="true" data-node></span>
      <div class="frame core">
        <p class="eyebrow">
          <span class="eyebrow__num">05</span> — THE CORE
        </p>
        <h2 id="core-title" class="core__title" data-reveal="lines">
          Forged in fire. <em>Built to stand.</em>
        </h2>
        <p class="core__body" data-reveal>
          Tell me a little about your business and I’ll come back to you with ideas, a price and a
          timeframe. No pressure, no jargon.
        </p>
        <div class="actions actions--center" data-reveal>
          <a class="btn btn--primary" href={CTA.href} data-magnetic>
            {CTA.label}
            <span class="btn__arrow" aria-hidden="true">
              →
            </span>
          </a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </div>
        <a class="core__lab" href="/lab" data-reveal>
          CURIOUS WHAT ELSE I’VE BEEN BUILDING? VISIT THE LAB <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Motion and the stone load after first paint: the headline never waits for them.
  import { afterFirstPaint } from '../lib/motion';

  let cleanup: (() => void) | null = null;

  function mount() {
    const root = document.querySelector<HTMLElement>('[data-landing]');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = 'true';
    afterFirstPaint(async () => {
      if (!root.isConnected) return;
      const [orbit, landing] = await Promise.all([
        import('../lib/orbit'),
        import('../lib/landing'),
      ]);
      if (!root.isConnected) return;
      // The hero's pin first: everything below is measured after its spacing.
      const stops = [orbit.mountOrbit(root), landing.mountLanding(root)];
      cleanup = () => stops.forEach((stop) => stop());
    });
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ── The strata system ───────────────────────────────────────────────── */
  .landing {
    --thread-x: clamp(18px, 3vw, 44px);
    --overlap: 40px;
    --pad-top: clamp(4.5rem, 3rem + 6vw, 8.5rem);
    --pad-bottom: clamp(5rem, 3rem + 7vw, 9.5rem);
    position: relative;
    isolation: isolate;
    background: var(--basalt);
  }

  .frame {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-left: clamp(48px, 7vw, 112px);
    padding-right: clamp(20px, 4vw, 64px);
  }

  .stratum {
    position: relative;
    padding-block: calc(var(--pad-top) + var(--overlap)) var(--pad-bottom);
  }

  /* Each stratum after the hero rides up over the one above, along its own edge. */
  .stratum:not(.stratum--hero) {
    margin-top: calc(var(--overlap) * -1);
  }

  .stratum__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--basalt);
  }

  .stratum--alt .stratum__bg {
    background: var(--basalt-2);
  }

  .stratum__edge {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--overlap);
    overflow: visible;
    pointer-events: none;
  }

  .stratum__edge polyline {
    fill: none;
    stroke: rgb(var(--lava-rgb) / 0.62);
    stroke-width: 1.5px;
    stroke-linejoin: round;
  }

  /* The lava thread: dim, with the lit part following the page's scroll (lib/landing.ts). */
  .thread {
    position: absolute;
    top: calc(var(--nav-height) + var(--nav-offset) + var(--space-l));
    bottom: 0;
    left: var(--thread-x);
    z-index: 3;
    width: 2px;
    background: var(--rule-ember);
    pointer-events: none;
  }

  .thread__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--lava-hot), var(--lava) 18%, var(--ember));
    transform-origin: 50% 0;
  }

  .node {
    position: absolute;
    top: calc(var(--pad-top) + var(--overlap) + 0.1rem);
    left: calc(var(--thread-x) - 5px);
    z-index: 4;
    width: 12px;
    height: 12px;
    border: 1px solid var(--ember);
    border-radius: 50%;
    background: var(--basalt);
    pointer-events: none;
  }

  .stratum--hero .node {
    top: calc(var(--hero-top) + 0.1rem);
  }

  /* Lit: a lava core and a soft glow, faded in (opacity only). */
  .node::before,
  .node::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .node::before {
    inset: 2px;
    background: var(--lava);
  }

  .node::after {
    inset: -7px;
    background: radial-gradient(circle, rgb(var(--lava-rgb) / 0.55), transparent 70%);
  }

  /* With JS and motion the thread lights as you go; otherwise it's lit throughout. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .thread__fill {
      transform: scaleY(0);
    }

    :global(html.js) .node:not(:global(.is-lit))::before,
    :global(html.js) .node:not(:global(.is-lit))::after {
      opacity: 0;
    }
  }

  /* ── Type ────────────────────────────────────────────────────────────── */
  .eyebrow {
    color: var(--ash);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-mono);
