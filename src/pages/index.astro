---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hud from '../components/Hud.astro';
import FaceCard from '../components/FaceCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES, SITE, CTA } from '../lib/site';
import { getWork, toProject } from '../lib/work';
import { getCollection } from 'astro:content';

// The story has a face for each of the first two projects; the concept sits in the Lab chapter.
const work = (await getWork()).map(toProject);
const seqdvgc = work.find((p) => p.slug === 'seqdvgc')!;
const allen = work.find((p) => p.slug === 'allen-gillon')!;
const concept = work.find((p) => p.isConcept)!;
const lab = (await getCollection('lab')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout>
  <Hud />

  <!--
    The scroll story: Chapters 00–04 in one container. The scene renders while
    any of it is on screen (data-scene-anchor) and rests at the plain section.
    src/lib/story.ts measures [data-story-anchor] blocks to place each chapter.
  -->
  <div class="story" data-story data-scene-anchor>
    <!-- 00 — Arrival -->
    <section id="arrival" class="hero" aria-labelledby="hero-title">
      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="label hero__eyebrow">
            <span class="chapter-num">00</span> Monolith Web Studio · {SITE.location}
          </p>
          <h1 id="hero-title" class="display hero__title" data-chapter-heading tabindex="-1">
            <span class="hero__line">Forged in fire.</span>
            <span class="hero__line">
              <em>Built to stand.</em>
            </span>
          </h1>
          <p class="lead hero__intro">
            I design and build websites for businesses across South East Queensland. Award-level
            craft that stays fast, accessible and easy to update. One person, start to finish.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={CTA.href}>
              {CTA.label}
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            </a>
            <a class="btn btn--ghost" href="#face-i">
              Skip to the work
              <span class="btn__arrow" aria-hidden="true">
                ↓
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 01 — Face I: the left face. Copy left, stone right. -->
    <section id="face-i" class="chapter chapter--left" aria-labelledby={`project-${seqdvgc.slug}`}>
      <div class="container chapter__inner" data-story-anchor="1">
        <p class="label chapter__eyebrow" data-reveal>
          <span class="chapter-num">01</span> Face I · Selected work
        </p>
        <div class="chapter__block" data-reveal>
          <FaceCard project={seqdvgc} level={2} chapterHeading />
        </div>
      </div>
    </section>

    <!-- 02 — Face II: the back face. Copy right, stone left. -->
    <section id="face-ii" class="chapter chapter--right" aria-labelledby={`project-${allen.slug}`}>
      <div class="container chapter__inner" data-story-anchor="2">
        <p class="label chapter__eyebrow" data-reveal>
          <span class="chapter-num">02</span> Face II · Selected work
        </p>
        <div class="chapter__block" data-reveal>
          <FaceCard project={allen} level={2} chapterHeading />
        </div>
      </div>
    </section>

    <!-- 03 — The Lab: the right face. Copy left, stone right. -->
    <section id="the-lab" class="chapter chapter--left" aria-labelledby="the-lab-title">
      <div class="container chapter__inner" data-story-anchor="3">
        <p class="label chapter__eyebrow" data-reveal>
          <span class="chapter-num">03</span> The Lab
        </p>
        <div class="chapter__panel">
          <h2
            id="the-lab-title"
            class="display-2"
            data-chapter-heading
            tabindex="-1"
            data-reveal="lines"
          >
            Experiments in <em>light and stone.</em>
          </h2>
          <p class="lead" data-reveal>
            The Lab is where I test ideas before they reach a client’s site: shaders, motion studies
            and interaction experiments.
          </p>
          <ul class="lab-list" data-reveal>
            {lab.map((entry) => (
              <li>
                <a class="lab-list__link" href={`/lab/${entry.id}`}>
                  <span class="lab-list__title">{entry.data.title}</span>
                  <span class="lab-list__summary">{entry.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="btn btn--ghost" href="/lab" data-reveal>
            Visit the Lab
            <span class="btn__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
        <div class="chapter__block" data-reveal>
          <FaceCard project={concept} />
        </div>
      </div>
    </section>

    <!--
      04 — The Core: the front face. The services summary is read first (copy
      right, stone left). Then the camera dives into the core fissure: the
      screen washes to molten light in the empty stretch between the blocks,
      and the closing CTA only enters once the wash has cooled to magma.
    -->
    <section
      id="the-core"
      class="chapter chapter--right chapter--core"
      aria-labelledby="the-core-title"
    >
      <div class="container chapter__inner" data-story-anchor="4">
        <p class="label chapter__eyebrow" data-reveal>
          <span class="chapter-num">04</span> The Core
        </p>
        <div class="chapter__panel core__lead">
          <h2
            id="the-core-title"
            class="heading core__title"
            data-chapter-heading
            tabindex="-1"
            data-reveal="lines"
          >
            Three ways to work together. Every one is hand-built by me.
          </h2>
          <ul class="core__services">
            {SERVICES.map((service, index) => (
              <li data-reveal>
                <ServiceCard service={service} index={index} />
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="core__dive" aria-hidden="true"></div>

      <div class="container core__cta" data-story-cta>
        <h3 class="display-2 core__cta-title" data-reveal="lines">
          Let’s make something <em>that stands.</em>
        </h3>
        <div class="hero__actions" data-reveal>
          <a class="btn btn--primary" href={CTA.href}>
            {CTA.label}
            <span class="btn__arrow" aria-hidden="true">
              →
            </span>
          </a>
          <a class="btn btn--ghost" href="/services">
            Services and pricing
            <span class="btn__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- The plain safety net: everything a visitor needs, no experience required. -->
  <section class="plain" aria-labelledby="plain-title" data-hud-end>
    <div class="container">
      <h2 id="plain-title" class="heading plain__title">
        The short version
      </h2>
      <div class="plain__grid">
        <div class="plain__col">
          <h3 class="label">What I make</h3>
          <dl class="plain__services">
            {SERVICES.map((service) => (
              <div class="plain__service">
                <dt>
                  <span class="plain__service-name">{service.name}</span>
                  <span class="plain__service-pkg">{service.package}</span>
                </dt>
                <dd>{service.description}</dd>
                <dd class="plain__price">{service.price}</dd>
              </div>
            ))}
          </dl>
          <p>Ongoing care and hosting: [DETAILS TO BE SUPPLIED]</p>
        </div>

        <div class="plain__col">
          <h3 class="label">Who I am</h3>
          <p>
            I’m {SITE.founder}, a designer and developer working on my own from Wamuran, at the foot
            of the Glasshouse Mountains. You talk to the person who makes your site, from the first
            call to launch day and after.
          </p>
          <p>
            <a href="/about">More about me and how I work</a>
          </p>
        </div>

        <div class="plain__col">
          <h3 class="label">Start a project</h3>
          <p>
            Tell me what you need and roughly what you’d like to spend. I’ll come back with honest
            advice, even if that’s “you don’t need me yet”.
          </p>
          <p>Email: {SITE.email}</p>
          <a class="btn btn--primary" href={CTA.href}>
            {CTA.label}
            <span class="btn__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chapter-num {
    color: var(--lava);
    margin-right: 0.5em;
  }

  /* ── 00 Arrival ──────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: calc(var(--nav-height) + var(--space-3xl)) var(--space-2xl);
  }

  /* A scrim behind the copy keeps text contrast independent of the scene. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        0deg,
        rgb(var(--basalt-rgb) / 0.9) 0%,
        rgb(var(--basalt-rgb) / 0.72) 42%,
        transparent 64%
      ),
      linear-gradient(180deg, rgb(var(--basalt-rgb) / 0.5) 0%, transparent 18%);
  }

  .hero__inner {
    position: relative;
    display: grid;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    max-width: 44rem;
  }

  /* Small text over the scene: bone, not ash, so contrast holds over the glow. */
  .hero__eyebrow {
    color: var(--bone);
  }

  .hero__title {
    display: grid;
  }

  .hero__line {
    display: block;
  }

  .hero__intro {
    max-width: 36ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  /* Desktop: copy sits right of the monolith, which stands just left of centre. */
  @media (min-width: 64rem) {
    .hero::before {
      background:
        linear-gradient(
          90deg,
          transparent 38%,
          rgb(var(--basalt-rgb) / 0.5) 58%,
          rgb(var(--basalt-rgb) / 0.72) 100%
        ),
        linear-gradient(0deg, rgb(var(--basalt-rgb) / 0.75) 0%, transparent 40%),
        linear-gradient(180deg, rgb(var(--basalt-rgb) / 0.5) 0%, transparent 18%);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    }

    .hero__copy {
      grid-column: 2;
    }

    .hero__title {
      font-size: min(var(--step-5), 5.1vw);
    }
  }

  /* ── Chapters 01–04 ──────────────────────────────────────────────────── */
  .story {
    position: relative;
  }

  .chapter {
    position: relative;
    display: grid;
    align-content: center;
    padding-block: var(--space-section);
  }

  .chapter__inner {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
    align-content: start;
  }

  .chapter__block,
  .chapter__panel {
    width: 100%;
    max-width: 40rem;
  }

  /* Copy over the scene sits on an obsidian panel, so its contrast never depends on the frame. */
  .chapter__panel {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    padding: var(--space-xl) var(--space-l) var(--space-l);
    border: var(--hairline);
    border-top: var(--rule-accent);
    border-radius: var(--radius-panel);
    background: var(--panel-bg);
  }

  /* Small labels over the scene: bone on a basalt backing, so lava behind never washes them out. */
  .chapter__eyebrow {
    padding: 0.35em 0.75em;
    border-radius: var(--radius-panel);
    background: rgb(var(--basalt-rgb) / 0.82);
    color: var(--bone);
  }

  /* Desktop: copy on the side opposite the face in view. */
  @media (min-width: 64rem) {
    .chapter--right .chapter__inner {
      justify-items: end;
    }

    .chapter__block,
    .chapter__panel {
      max-width: min(40rem, 46vw);
    }
  }

  /*
   * With JS and motion, chapters are tall so the camera has room to travel, and
   * the Core leaves a stretch for the dive. Without JS, or with reduced motion,
   * the story stays compact: no empty scrolling past a static image.
   * lvh units: the mobile address bar showing or hiding never changes these.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .chapter {
      min-height: 150lvh;
      padding-block: var(--space-2xl);
    }

    :global(html.js) .chapter--core {
      display: block;
      min-height: 0;
      padding-block: 25lvh 0;
    }

    :global(html.js) .core__dive {
      height: 120lvh;
    }

    :global(html.js) .core__cta {
      padding-bottom: 30lvh;
    }
  }

  .lab-list {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lab-list__link {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-s) 0;
    border-top: var(--hairline);
    border-bottom: var(--hairline);
    text-decoration: none;
  }

  .lab-list__title {
    color: var(--bone);
    font-weight: var(--weight-strong);
  }

  .lab-list__link:hover .lab-list__title {
    color: var(--lava);
  }

  .lab-list__summary {
    max-width: var(--measure);
    color: var(--ash-soft);
    font-size: var(--step--1);
  }

  .core__title {
    max-width: 24ch;
  }

  .core__services {
    display: grid;
    gap: var(--space-s);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .core__cta {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
    margin-top: var(--space-2xl);
  }

  .core__cta-title {
    max-width: 14ch;
  }

  /* ── The plain section ───────────────────────────────────────────────── */
  .plain {
    position: relative;
    padding-block: var(--space-3xl);
    border-top: var(--hairline);
    background: var(--basalt);
  }

  .plain__title {
    margin-bottom: var(--space-xl);
  }

  .plain__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-xl);
  }

  .plain__col {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-s);
  }

  .plain__services {
    display: grid;
    gap: var(--space-s);
    width: 100%;
    margin: 0;
  }

  .plain__service {
    display: grid;
    gap: 0.2rem;
    padding-bottom: var(--space-s);
    border-bottom: var(--hairline);
  }

  .plain__service dt {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    align-items: baseline;
  }

  .plain__service-name {
    color: var(--bone);
    font-weight: var(--weight-strong);
  }

  .plain__service-pkg {
    color: var(--ash);
    font-size: var(--step--1);
  }

  .plain__service dd {
    margin: 0;
  }

  .plain__price {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--bone);
  }
</style>
