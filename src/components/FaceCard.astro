---
import type { Project } from '../lib/site';

interface Props {
  project: Project;
  /** Heading level for the project title inside the page outline. */
  level?: 2 | 3;
}

const { project, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const titleId = `project-${project.slug}`;
---

<article class="face-card" aria-labelledby={titleId}>
  <div class="face-card__meta">
    <p class="label">{project.clientType}</p>
    {project.concept && <p class="face-card__badge label">Concept</p>}
  </div>

  <Heading id={titleId} class="face-card__title">
    {project.title}
  </Heading>
  <p class="face-card__client">{project.client}</p>
  <p class="face-card__summary">{project.summary}</p>

  <ul class="face-card__links">
    <li>
      <a class="btn btn--ghost" href={`/work/${project.slug}`}>
        {project.concept ? 'View the concept' : 'Read the case study'}
        <span class="visually-hidden">: {project.title}</span>
        <span class="btn__arrow" aria-hidden="true">
          →
        </span>
      </a>
    </li>
    {project.liveUrl && (
      <li>
        <a class="face-card__live" href={project.liveUrl} rel="noopener" target="_blank">
          Visit the live site<span class="visually-hidden"> (opens in a new tab)</span>
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    )}
  </ul>
</article>

<style>
  .face-card {
    position: relative;
    display: grid;
    gap: var(--space-s);
    max-width: 40rem;
    padding: var(--space-xl) var(--space-l) var(--space-l);
    border: var(--hairline);
    border-top: var(--rule-accent);
    border-radius: var(--radius-panel);
    background: var(--panel-bg);
  }

  .face-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .face-card__badge {
    padding: 0.2em 0.8em;
    border: 1px solid var(--lava);
    border-radius: var(--radius-pill);
    color: var(--bone);
  }

  .face-card__title {
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
    overflow-wrap: anywhere;
  }

  .face-card__client {
    color: var(--bone);
  }

  .face-card__summary {
    max-width: var(--measure);
  }

  .face-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    margin: var(--space-xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .face-card__live {
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
    min-height: 44px;
    font-size: var(--step--1);
  }
</style>
