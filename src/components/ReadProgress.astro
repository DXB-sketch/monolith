---
/**
 * A hairline reading-progress indicator at the top of the viewport, for case
 * studies and lab entries. Pure CSS (a scroll-driven animation, compositor
 * only); browsers without scroll timelines simply don't show it. Decorative:
 * the scrollbar and the page itself carry the same information.
 */
---

<div class="read-progress" aria-hidden="true"></div>

<style>
  .read-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .read-progress {
      display: block;
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      z-index: var(--z-nav);
      height: 1px;
      background: var(--lava);
      transform: scaleX(0);
      transform-origin: 0 50%;
      pointer-events: none;
      /* Longhands, and the timeline through a custom property: the CSS minifier
         otherwise folds the timeline into the animation shorthand, which
         browsers reject as invalid. */
      --read-timeline: scroll(root block);
      animation-name: read-progress;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: var(--read-timeline);
    }

    /* It follows the reader's own scrolling, so it stays with reduced motion too. */
    @media (prefers-reduced-motion: reduce) {
      .read-progress {
        animation-duration: auto !important;
      }
    }
  }

  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }
</style>
