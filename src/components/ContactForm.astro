---
/**
 * The project brief. Without JS: one page of fieldsets that POSTs to
 * /api/contact (errors come back through /contact). With JS
 * (src/lib/contact-form.ts): one fieldset per step, "Step 2 of 5" announced
 * politely, Back and Next, validation per step, focus on each step's legend, a
 * draft kept in sessionStorage, and JSON submission.
 */
import {
  BUDGETS,
  HONEYPOT,
  MESSAGE_MAX,
  NEEDS,
  STEPS,
  TIMELINES,
  TOKEN,
  type FieldErrors,
  type FieldName,
} from '../lib/contact-schema';
import { SITE } from '../lib/site';
import ContactSuccess from './ContactSuccess.astro';

interface Props {
  token: string;
  values?: Record<string, string>;
  errors?: FieldErrors;
  /** The last plain-form send failed, or the request was unreadable. */
  formError?: 'send' | 'invalid' | null;
}

const { token, values = {}, errors = {}, formError = null } = Astro.props;
const errorEntries = Object.entries(errors) as [FieldName, string][];
const hasErrors = errorEntries.length > 0 || Boolean(formError);

/** The first control of a field, for the summary's links. */
const anchor = (field: FieldName) =>
  field === 'need' || field === 'budget' || field === 'timeline'
    ? `field-${field}-0`
    : `field-${field}`;
const LABELS: Record<FieldName, string> = {
  need: 'What you need',
  budget: 'Budget',
  timeline: 'Timeline',
  name: 'Name',
  email: 'Email',
  business: 'Business',
  phone: 'Phone',
  message: 'Project',
};
const describe = (field: FieldName) => `error-${field}`;
const invalid = (field: FieldName) => (errors[field] ? 'true' : undefined);
const CHOICES = { need: NEEDS, budget: BUDGETS, timeline: TIMELINES } as const;
const FORM_ERRORS = {
  send: `The brief couldn’t be sent just now. Please try again, or email ${SITE.email}.`,
  invalid: `Something went wrong reading the form. Please try again, or email ${SITE.email}.`,
};
---

<div class="brief-wrap">
  <form class="brief" method="post" action="/api/contact" data-brief>
    <div
      class="brief__summary"
      id="form-errors"
      tabindex="-1"
      aria-labelledby="form-errors-title"
      role="region"
      hidden={!hasErrors}
      data-brief-summary
    >
      <h2 id="form-errors-title" class="subheading">
        There’s a problem with the brief
      </h2>
      {formError && <p data-brief-form-error>{FORM_ERRORS[formError]}</p>}
      <ul data-brief-summary-list>
        {errorEntries.map(([field, message]) => (
          <li>
            <a href={`#${anchor(field)}`}>
              {LABELS[field]}: {message}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="brief__progress label" aria-live="polite" data-brief-progress hidden></p>
    {/* Decorative: each completed step leaves a thin lava line (the text above says it in words). */}
    <ol class="brief__track" aria-hidden="true" data-brief-track hidden>
      {STEPS.map(() => (
        <li />
      ))}
    </ol>

    {STEPS.map((step, index) => (
      <fieldset class="brief__step" data-brief-step={step.id} id={`step-${step.id}`}>
        <legend class="brief__legend" tabindex="-1" data-brief-legend>
          <span class="label brief__num">0{index + 1}</span>
          <span class="subheading">{step.legend}</span>
        </legend>

        {(step.id === 'need' || step.id === 'budget' || step.id === 'timeline') && (
          <>
            <p class="brief__error" id={describe(step.id)} hidden={!errors[step.id]}>
              {errors[step.id]}
            </p>
            <div class="brief__choices">
              {CHOICES[step.id].map((option, i) => (
                <label class="choice">
                  <input
                    type="radio"
                    id={`field-${step.id}-${i}`}
                    name={step.id}
                    value={option.value}
                    required
                    checked={values[step.id] === option.value}
                    aria-describedby={describe(step.id)}
                    aria-invalid={invalid(step.id)}
                  />
                  <span>{option.label}</span>
                </label>
              ))}
            </div>
          </>
        )}

        {step.id === 'details' && (
          <div class="brief__fields">
            <div class="field">
              <label for="field-name">Name</label>
              <p class="brief__error" id={describe('name')} hidden={!errors.name}>
                {errors.name}
              </p>
              <input
                id="field-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="100"
                value={values.name}
                aria-describedby={describe('name')}
                aria-invalid={invalid('name')}
              />
            </div>
            <div class="field">
              <label for="field-email">Email</label>
              <p class="brief__error" id={describe('email')} hidden={!errors.email}>
                {errors.email}
              </p>
              <input
                id="field-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="200"
                value={values.email}
                aria-describedby={describe('email')}
                aria-invalid={invalid('email')}
              />
            </div>
            <div class="field">
              <label for="field-business">
                Business or organisation <span class="field__optional">(optional)</span>
              </label>
              <p class="brief__error" id={describe('business')} hidden={!errors.business}>
                {errors.business}
              </p>
              <input
                id="field-business"
                name="business"
                type="text"
                autocomplete="organization"
                maxlength="120"
                value={values.business}
                aria-describedby={describe('business')}
                aria-invalid={invalid('business')}
              />
            </div>
            <div class="field">
              <label for="field-phone">
                Phone <span class="field__optional">(optional)</span>
              </label>
              <p class="brief__error" id={describe('phone')} hidden={!errors.phone}>
                {errors.phone}
              </p>
              <input
                id="field-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                maxlength="40"
                value={values.phone}
                aria-describedby={describe('phone')}
                aria-invalid={invalid('phone')}
              />
            </div>
          </div>
        )}

        {step.id === 'message' && (
          <div class="field">
            <label for="field-message">
              What’s the project? Who is it for, and what should it do?
            </label>
            <p class="brief__error" id={describe('message')} hidden={!errors.message}>
              {errors.message}
            </p>
            <textarea
              id="field-message"
              name="message"
              rows="8"
              required
              maxlength={MESSAGE_MAX}
              aria-describedby={describe('message')}
              aria-invalid={invalid('message')}
              set:text={values.message ?? ''}
            />
          </div>
        )}
      </fieldset>
    ))}

    {/* Spam trap: people never see or reach it; bots fill it in. */}
    <div class="brief__trap" aria-hidden="true">
      <label>
        Leave this empty
        <input type="text" name={HONEYPOT} tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <input type="hidden" name={TOKEN} value={token} />

    <div class="brief__nav">
      <button class="btn btn--ghost" type="button" data-brief-back hidden>
        <span aria-hidden="true">←</span> Back
      </button>
      <button class="btn btn--primary" type="button" data-brief-next hidden>
        Next{' '}
        <span class="btn__arrow" aria-hidden="true">
          →
        </span>
      </button>
      <button class="btn btn--primary" type="submit" data-brief-submit>
        Send the brief{' '}
        <span class="btn__arrow" aria-hidden="true">
          →
        </span>
      </button>
    </div>
  </form>

  <ContactSuccess hidden headingLevel={2} />
</div>

<script>
  import { initBrief } from '../lib/contact-form';
  document.addEventListener('astro:page-load', initBrief);
</script>

<style>
  .brief {
    display: grid;
    gap: var(--space-l);
    max-width: 44rem;
  }

  .brief__summary {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-l);
    border: 1px solid var(--lava);
    border-radius: var(--radius-panel);
    background: rgb(var(--basalt-rgb) / 0.9);
  }

  .brief__summary[hidden] {
    display: none;
  }

  .brief__summary ul {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding-left: 1.2em;
  }

  .brief__summary a {
    color: var(--bone);
  }

  .brief__summary:focus {
    outline: 2px solid var(--lava);
    outline-offset: 4px;
  }

  .brief__progress[hidden],
  .brief__track[hidden] {
    display: none;
  }

  .brief__track {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-2xs);
    margin: calc(var(--space-s) * -1) 0 0;
    padding: 0;
    list-style: none;
  }

  .brief__track li {
    height: 1px;
    background: var(--obsidian-edge);
    transition: background-color var(--dur-slow) var(--ease-out);
  }

  .brief__track li:global(.is-current) {
    background: rgb(var(--bone-rgb) / 0.5);
  }

  .brief__track li:global(.is-done) {
    background: var(--lava);
  }

  .brief__step {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: var(--space-l);
    border: var(--hairline);
    border-top: var(--rule-accent);
    border-radius: var(--radius-panel);
    background: var(--panel-bg);
    min-width: 0;
  }

  .brief__step[hidden] {
    display: none;
  }

  .brief__legend {
    display: grid;
    gap: var(--space-2xs);
    float: left;
    width: 100%;
    margin-bottom: var(--space-s);
    padding: 0;
  }

  .brief__legend:focus {
    outline: none;
  }

  .brief__legend:focus-visible .subheading {
    text-decoration: underline;
    text-decoration-color: var(--lava);
  }

  .brief__num {
    color: var(--lava);
  }

  .brief__choices {
    display: grid;
    gap: var(--space-xs);
    clear: both;
  }

  .choice {
    display: flex;
    gap: var(--space-s);
    align-items: center;
    min-height: 44px;
    padding: var(--space-s) var(--space-m);
    border: var(--hairline);
    border-radius: var(--radius-panel);
    background: rgb(var(--obsidian-rgb) / 0.6);
    color: var(--bone);
    cursor: pointer;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .choice:hover,
  .choice:has(input:checked) {
    border-color: var(--lava);
  }

  .choice input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--lava);
  }

  .brief__fields {
    display: grid;
    gap: var(--space-m);
    clear: both;
  }

  .field {
    display: grid;
    gap: var(--space-2xs);
    clear: both;
  }

  .field label {
    color: var(--bone);
  }

  .field__optional {
    color: var(--ash);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.7em 0.9em;
    border: 1px solid var(--obsidian-edge);
    border-radius: var(--radius-panel);
    background: rgb(var(--basalt-rgb) / 0.8);
    color: var(--bone);
    font: inherit;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--lava);
  }

  .field [aria-invalid='true'] {
    border-color: var(--lava);
  }

  .brief__error {
    clear: both;
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    color: var(--lava-hot);
  }

  .brief__error[hidden] {
    display: none;
  }

  .brief__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .brief__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .brief__nav [hidden] {
    display: none;
  }

  .brief[hidden] {
    display: none;
  }
</style>
