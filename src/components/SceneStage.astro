---
/**
 * The persistent, decorative scene layer: a static poster that is always present,
 * and the WebGL canvas that cross-fades in over it once the first frame renders.
 * Persisted across ClientRouter navigations with transition:persist.
 *
 * Nothing in here carries information. It is aria-hidden and never receives
 * pointer events; the scene reads the pointer from the window instead.
 */
---

<div class="stage" aria-hidden="true" data-scene-stage transition:persist="scene">
  <picture class="stage__poster">
    <source
      type="image/avif"
      media="(orientation: portrait)"
      srcset="/posters/hero-portrait-720.avif 720w, /posters/hero-portrait-1080.avif 1080w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      media="(orientation: portrait)"
      srcset="/posters/hero-portrait-720.webp 720w, /posters/hero-portrait-1080.webp 1080w"
      sizes="100vw"
    />
    <source
      type="image/avif"
      srcset="/posters/hero-1280.avif 1280w, /posters/hero-1920.avif 1920w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/posters/hero-1280.webp 1280w, /posters/hero-1920.webp 1920w"
      sizes="100vw"
    />
    <img
      src="/posters/hero-1280.webp"
      alt=""
      width="1280"
      height="720"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <canvas class="stage__canvas" data-scene-canvas tabindex="-1"></canvas>
  <!-- Lite has no post-processing chain: its grain and vignette are CSS, free on the GPU. -->
  <div class="stage__look"></div>
  <!-- Chapter 04's wash, drawn here whenever the scene runs without post-processing. -->
  <div class="stage__wash" data-scene-wash></div>
  <!-- Content pages: darken the scene on the text's side so the page leads. -->
  <div class="stage__scrim"></div>
</div>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: var(--z-scene);
    overflow: hidden;
    pointer-events: none;
    /* Backdrop painted before the poster arrives: the dusk sky in CSS. */
    background:
      radial-gradient(120% 60% at 40% 62%, var(--ember) 0%, transparent 60%),
      linear-gradient(180deg, var(--basalt) 0%, var(--magma) 58%, var(--basalt) 72%);
    transition: opacity var(--dur-fade) var(--ease-out);
  }

  .stage__poster,
  .stage__poster img,
  .stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stage__poster img {
    object-fit: cover;
    object-position: 50% 60%;
  }

  .stage__wash {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /* The vignette (as the post chain's: darkening from about 30% out) and a
     fine static grain, over the live canvas on Lite only. */
  .stage__look {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(
      ellipse 75% 75% at 50% 50%,
      transparent 40%,
      rgb(var(--basalt-rgb) / 0.55) 100%
    );
    transition: opacity var(--dur-fade) var(--ease-out);
  }

  .stage__look::after {
    content: '';
    position: absolute;
    inset: 0;
    background-size: 128px 128px;
    mix-blend-mode: overlay;
    opacity: 0.1;
  }

  /* Only Lite downloads the grain tile. */
  :global(html[data-tier='lite']) .stage__look::after {
    background-image: url('/textures/grain.png');
  }

  :global(html[data-tier='lite']) .stage:global(.is-live) .stage__look {
    opacity: 1;
  }

  .stage__canvas {
    opacity: 0;
    outline: none;
    transition: opacity var(--dur-fade) var(--ease-out);
  }

  /* The canvas has rendered its first frame: cross-fade from the poster. */
  .stage:global(.is-live) .stage__canvas {
    opacity: 1;
  }

  /* Home, scrolled past the story: rest dimly. */
  .stage:global(.is-dormant) {
    opacity: 0.32;
  }

  /*
   * Content pages show their own view of the stone, calmer than the story:
   * the whole stage is held down a little, and a scrim darkens the side the
   * text sits on (left in landscape; everywhere in portrait, top lightest).
   * Contrast behind every main text block is measured in PHASE_4_COMPLETE.md.
   */
  .stage:global(.is-view) {
    opacity: var(--view-stage-opacity);
  }

  .stage__scrim {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(
      90deg,
      rgb(var(--basalt-rgb) / 0.86) 0%,
      rgb(var(--basalt-rgb) / 0.8) 50%,
      rgb(var(--basalt-rgb) / 0.5) 76%,
      rgb(var(--basalt-rgb) / 0.15) 100%
    );
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  @media (orientation: portrait) {
    .stage__scrim {
      background: linear-gradient(
        180deg,
        rgb(var(--basalt-rgb) / 0.45) 0%,
        rgb(var(--basalt-rgb) / 0.78) 35%,
        rgb(var(--basalt-rgb) / 0.86) 100%
      );
    }
  }

  .stage:global(.is-view) .stage__scrim {
    opacity: 1;
  }

  /* During a page change the stone dips briefly, so the change reads as intentional. */
  .stage:global(.is-navigating) {
    opacity: var(--nav-stage-opacity);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  /* Poster tier: no WebGL, a gentle scroll-linked drift on the poster in pure CSS. */
  @supports (animation-timeline: scroll()) {
    :global(html[data-tier='poster']) .stage__poster {
      /* Longhands, and the timeline through a custom property: the CSS minifier
         otherwise folds the timeline into the animation shorthand, which
         browsers reject as invalid (this drift never ran in production before). */
      --drift-timeline: scroll(root block);
      animation-name: poster-drift;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: var(--drift-timeline);
      animation-range: 0 100vh;
    }
  }

  @keyframes poster-drift {
    from {
      transform: scale(1.06) translateY(0);
    }
    to {
      transform: scale(1.06) translateY(-2.5%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__poster {
      animation: none !important;
    }
  }
</style>
