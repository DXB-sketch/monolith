---
import type { Service } from '../lib/site';

interface Props {
  service: Service;
  index: number;
  /** The Services page also lists what's included. */
  detailed?: boolean;
  /** Heading level for the package name. */
  level?: 2 | 3;
}

const { service, index, detailed = false, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<article class="service-card" data-sheen>
  <p class="label">
    <span class="service-card__num">0{index + 1}</span> {service.package}
  </p>
  <Heading class="service-card__name">{service.name}</Heading>
  <p class="service-card__desc">{service.description}</p>
  {detailed && (
    <div class="service-card__included">
      <p class="label">What’s included</p>
      <ul>
        {service.included.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  )}
  <slot />
  <p class="service-card__price">{service.price}</p>
</article>

<style>
  .service-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    gap: var(--space-s);
    height: 100%;
    padding: var(--space-l);
    border: var(--hairline);
    border-top: var(--rule-accent);
    border-radius: var(--radius-panel);
    background: var(--panel-bg);
  }

  .service-card__num {
    color: var(--lava);
  }

  .service-card__name {
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
  }

  .service-card__included {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .service-card__included ul {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding-left: 1.2em;
  }

  .service-card__included li::marker {
    color: var(--lava);
  }

  /* Anything slotted in (the Eruption card's note on /services). */
  .service-card :global(.service-card__note) {
    padding: var(--space-s);
    border: var(--hairline);
    border-radius: var(--radius-panel);
    color: var(--ash-soft);
    font-size: var(--step--1);
  }

  .service-card__price {
    padding-top: var(--space-s);
    border-top: var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--bone);
  }
</style>
