---
/**
 * The gate at the top of /potential (Phase 6). The 3D story is opt-in: this
 * panel explains what it is, checks the device (src/lib/gate.ts), and only
 * then offers "Enter the stone". It is never shown once the visitor has
 * entered 3D (html[data-entered]), and comes back if they leave it.
 *
 * Without JavaScript only the explanation and the way back show; the story
 * below is plain HTML either way.
 */
---

<section class="gate" aria-labelledby="gate-title" data-gate data-state="idle">
  <div class="container gate__inner">
    <div class="gate__panel">
      <p class="label gate__eyebrow">FULL 3D · OPTIONAL · HIGH PERFORMANCE</p>
      <h1 id="gate-title" class="display-2 gate__title" tabindex="-1">
        See the potential.
      </h1>
      <p class="gate__body">
        This is the Molten Core: a real-time 3D scroll story built at the very top end of what a
        browser can do. It runs best on a recent laptop, desktop or flagship phone. Before it
        starts, I’ll run a quick check so it only plays where it plays smoothly.
      </p>

      <ol class="gate__checks" aria-label="Device check">
        <li class="gate__check" data-check="graphics" data-status="waiting">
          <span class="gate__icon" aria-hidden="true"></span>
          <span class="gate__name">Graphics support</span>
          <span class="gate__status" data-check-status>
            Waiting
          </span>
        </li>
        <li class="gate__check" data-check="loading" data-status="waiting">
          <span class="gate__icon" aria-hidden="true"></span>
          <span class="gate__name">Loading the scene</span>
          <span class="gate__status" data-check-status>
            Waiting
          </span>
        </li>
        <li class="gate__check" data-check="framerate" data-status="waiting">
          <span class="gate__icon" aria-hidden="true"></span>
          <span class="gate__name">Frame-rate test</span>
          <span class="gate__status" data-check-status>
            Waiting
          </span>
          <span class="gate__bar" aria-hidden="true">
            <span class="gate__bar-fill" data-gate-progress></span>
          </span>
        </li>
      </ol>

      <div class="gate__result" data-gate-result hidden>
        <p class="gate__result-title">Your device is better suited to the 2D site.</p>
        <p class="gate__result-why" data-gate-reason></p>
      </div>

      <div class="gate__actions">
        <button class="btn btn--primary gate__enter" type="button" disabled data-gate-enter>
          Enter the stone
          <span class="btn__arrow" aria-hidden="true">
            →
          </span>
        </button>
        <button class="btn btn--primary gate__run" type="button" hidden data-gate-run>
          Run the check
        </button>
        <a class="btn btn--primary" href="/" hidden data-gate-back>
          Back to the 2D site
          <span class="btn__arrow" aria-hidden="true">
            →
          </span>
        </a>
        <a class="btn btn--ghost" href="/" data-gate-stay>
          Stay in 2D
        </a>
      </div>

      <p class="gate__note">
        If your device doesn’t pass, you’ll go straight back to 2D. Nothing’s wrong with it; this
        scene is deliberately extreme. 3D stories I build for clients are made much lighter than
        this one.
      </p>

      <p class="visually-hidden" aria-live="polite" data-gate-live></p>
    </div>
  </div>
</section>

<script>
  import { mountGate } from '../lib/gate';

  function bind() {
    const root = document.querySelector<HTMLElement>('[data-gate]');
    if (root && !root.dataset.bound) {
      root.dataset.bound = 'true';
      mountGate(root);
    }
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .gate {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: calc(var(--nav-height) + var(--nav-offset) + var(--space-xl)) var(--space-xl);
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  /* The visitor already entered 3D: the story starts at once. */
  :global(html[data-entered]) .gate {
    display: none;
  }

  .gate[data-state='leaving'] {
    opacity: 0;
  }

  .gate__panel {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    max-width: 40rem;
    padding: var(--space-xl) var(--space-l) var(--space-l);
    border: var(--hairline);
    border-top: var(--rule-accent);
    border-radius: var(--radius-panel);
    background: var(--panel-bg);
    -webkit-backdrop-filter: var(--frost-blur);
    backdrop-filter: var(--frost-blur);
  }

  /* Wide screens: centred, clear of the HUD's readouts (left) and chapter index (right). */
  @media (min-width: 64rem) {
    .gate__panel {
      margin-inline: auto;
    }
  }

  @media (max-width: 22rem) {
    .gate__panel {
      padding-inline: var(--space-m);
    }
  }

  /* .btn and the grids set their own display: keep [hidden] meaning hidden. */
  .gate[hidden],
  .gate [hidden] {
    display: none;
  }

  .gate__eyebrow {
    color: var(--bone);
  }

  .gate__body {
    max-width: 52ch;
  }

  /* ── The checklist ─────────────────────────────────────────────────────── */
  .gate__checks {
    display: grid;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
  }

  .gate__check {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: var(--space-s);
    row-gap: var(--space-2xs);
    padding-block: var(--space-s);
    border-bottom: var(--hairline);
  }

  .gate__name {
    color: var(--bone);
  }

  .gate__status {
    color: var(--ash);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-align: right;
  }

  .gate__icon {
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--ash);
    border-radius: 50%;
  }

  [data-status='running'] .gate__icon {
    border-color: var(--lava);
    border-right-color: transparent;
    animation: gate-spin 900ms linear infinite;
  }

  [data-status='passed'] .gate__icon {
    border-color: var(--lava);
    background: var(--lava);
  }

  [data-status='passed'] .gate__status,
  [data-status='running'] .gate__status {
    color: var(--bone);
  }

  [data-status='failed'] .gate__icon {
    border-color: var(--bone);
    background: linear-gradient(
      45deg,
      transparent 44%,
      var(--bone) 44%,
      var(--bone) 56%,
      transparent 56%
    );
  }

  [data-status='failed'] .gate__status {
    color: var(--bone);
  }

  [data-status='skipped'] .gate__icon {
    border-style: dashed;
  }

  @keyframes gate-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .gate__bar {
    grid-column: 2 / -1;
    height: 2px;
    overflow: hidden;
    background: var(--obsidian-edge);
  }

  .gate__bar-fill {
    display: block;
    height: 100%;
    background: var(--lava);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  /* ── Result and actions ────────────────────────────────────────────────── */
  .gate__result {
    display: grid;
    gap: var(--space-3xs);
  }

  .gate__result-title {
    color: var(--bone);
    font-weight: var(--weight-strong);
  }

  .gate__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .gate__enter:disabled {
    background: var(--obsidian-edge);
    color: var(--ash);
    cursor: not-allowed;
  }

  .gate__note {
    color: var(--ash);
    font-size: var(--step--1);
    max-width: 56ch;
  }

  /* Without JavaScript: the explanation and the way back, nothing that needs a check. */
  :global(html:not(.js)) .gate__checks,
  :global(html:not(.js)) .gate__enter,
  :global(html:not(.js)) .gate__note {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-status='running'] .gate__icon {
      animation: none;
    }
  }
</style>
