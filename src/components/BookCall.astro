---
/**
 * Prefer to talk? Calls are arranged by email: no booking calendar, so
 * nothing third-party loads. The link carries `data-book-link` for the
 * cta_click analytics event.
 */
import { SITE } from '../lib/site';

interface Props {
  headingLevel?: 2 | 3;
  /**
   * The region's accessible name, where the page has another of these
   * sections (the form's success message on /contact): landmarks need
   * distinct names. Defaults to the visible heading.
   */
  label?: string;
}

const { headingLevel = 2, label } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const titleId = `book-title-${Math.random().toString(36).slice(2, 8)}`;
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent('Arranging a call')}`;
---

<section class="book" aria-labelledby={label ? undefined : titleId} aria-label={label}>
  <Heading id={titleId} class="subheading">
    Prefer to talk?
  </Heading>
  <p class="book__text">
    Email me and we’ll find a time for a short call: what you need, what it might cost, and whether
    I’m the right fit.
  </p>
  <div class="book__actions">
    <a class="btn btn--ghost" href={mailto} data-book-link>
      Arrange a call
      <span class="btn__arrow" aria-hidden="true">
        →
      </span>
    </a>
  </div>
</section>
<style>
  .book {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    padding: var(--space-l);
    border: var(--hairline);
    border-top: var(--rule-accent);
    border-radius: var(--radius-panel);
    background: var(--panel-bg);
  }

  .book__text {
    max-width: 48ch;
    color: var(--ash-soft);
  }

  .book__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    align-items: center;
  }
</style>
